// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:2-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers-extra/features/uv:1": {},
	},

	// Remap the container user's UID/GID to match the macOS host user.
	// This is required when running under Podman on macOS so that bind-mounted
	// workspace files (owned by the host UID) are writable inside the container.
	"updateRemoteUserUID": true,

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Fix any lingering ownership mismatches after container creation.
	"postCreateCommand": "sudo chown -R $(id -u):$(id -g) /workspaces/yuan-ti || true",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
