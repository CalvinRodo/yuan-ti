; Engine configuration file.
; Edit through the Godot editor's Project Settings where possible.

config_version=5

[application]

config/name="Dark Sun Engine"
config/description="A new engine for Dark Sun: Shattered Lands that reads the original game files."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="DarkSunEngine"
project/solution_directory="../"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true

[autoload]

PixelScaler="*res://scripts/PixelScaler.cs"
Music="*res://scripts/Music.cs"
Sounds="*res://scripts/Sounds.cs"
KeyHelp="*res://scripts/KeyHelp.cs"
ColourCycling="*res://scripts/ColourCycling.cs"
